{
  "name": "@regex-designer/js",
  "version": "0.1.1",
  "description": "A small TypeScript library for composing JavaScript regular expressions in a readable, reusable way.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "regex",
    "regexp",
    "pattern",
    "builder"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "check": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
