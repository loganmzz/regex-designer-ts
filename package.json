{
  "name": "@regex-designer/workspace",
  "version": "0.2.0",
  "description": "A small TypeScript library for composing regular expressions in a readable, reusable way.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/js"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "check": "npm run check --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
