{
  "name": "@regex-designer/re2",
  "version": "0.2.1",
  "description": "A small TypeScript library for composing RE2 regular expressions in a readable, reusable way.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "regex",
    "regexp",
    "pattern",
    "builder",
    "re2"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@regex-designer/core": "0.2.1",
    "re2": "1.27.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --config ../../eslint.config.* .",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/*.test.ts",
    "check": "npm run lint && npm run test"
  }
}
